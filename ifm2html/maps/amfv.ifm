# The Real World (2031)
################################################################################

################################################################################
# ROCKVIL, SOUTH DAKOTA
########################################
map "N Rockvil";

room "Park Entrance" tag rParkEntrance
     style ROAD
     style NAMECHANGE
     note "2071: Entrance to Halley Estates"
     exit s;
room "Aquarium & Kennedy" tag rAquariumKennedy
     style ROAD
     dir n n from rParkEntrance;
room "River & Kennedy" tag rRiverKennedy
     style ROAD
     dir n n n from rAquariumKennedy;
room "Aquarium & River" tag rAquariumRiver
     style ROAD
     dir e e e from rAquariumKennedy;
room "Aquarium & Park" tag rAquariumPark
     style ROAD
     dir w w w from rAquariumKennedy;
room "Zoo Entrance" tag rZooEntrance
     style ROAD
     dir w w w from rAquariumPark;
room "Aquarium Underpass" tag rAquariumUnderpass
     style ROAD
     dir w from rZooEntrance;
room "Bodanski Square" tag rBodanskiSquare
     style ROAD
     style SUBWAY
     dir s s from rAquariumRiver
     exit s sw;
room "Museum Entrance" tag rMuseumEntrance
     style ROAD
     dir e e e from rBodanskiSquare;
room "Airportway & River" tag rAirportwayRiver
     style ROAD
     dir n n from rAquariumRiver;
link rRiverKennedy to rAirportwayRiver dir e e e s;
room "River & Park" tag rRiverPark
     style ROAD
     dir w w w from rRiverKennedy;
room "Water Tower" tag rWaterTower
     style ROAD
     dir nw from rRiverPark;
room "Park Underpass" tag rParkUnderpass
     style ROAD
     dir w from rWaterTower;
room "Symphony Entrance" tag rSymphonyEntrance
     style ROAD
     dir e e e from rAirportwayRiver;
room "Airport Entrance" tag rAirportEntrance
     style ROAD
     dir ne from rSymphonyEntrance;

join rCentreKennedy to rParkEntrance
     go n;
join rCentreKennedy to rBodanskiSquare
     go ne;
join rMidlandRiver to rBodanskiSquare
     go n;


room "Skycar Lot" tag rSkycarLot_BodanskiSquare
     style BUILDING
     dir w from rBodanskiSquare;
room "Skycar Lot" tag rSkycarLot_ParkEntrance
     style BUILDING
     dir e from rParkEntrance;
link rSkycarLot_ParkEntrance to rSkycarLot_BodanskiSquare style BIGROOM;
room "First Methodist Church" tag rFirstMethodistChurch
     style BUILDING
     style NAMECHANGE
     note "2071: Vacant Lot"
     dir sw from rAquariumRiver;
link rSkycarLot_BodanskiSquare to rFirstMethodistChurch;
room "Dental School" tag rDentalSchool
     style BUILDING
     dir se from rAquariumKennedy;
room "Chun Building" tag rChunBuilding
     style BUILDING
     dir ne from rAquariumKennedy;
room "Bank" tag rBank
     style BUILDING
     dir nw from rAquariumKennedy;
room "Aquarium" tag rAquariumE
     style BUILDING
     dir sw from rAquariumKennedy;
room "Aquarium" tag rAquariumW
     style BUILDING
     dir se from rAquariumPark;
link rAquariumW to rAquariumE style BIGROOM;
room "Service Station" tag rServiceStation
     style BUILDING
     dir nw from rAquariumPark;
room "Skycar Lot" tag rSkycarLot_AquariumPark
     style BUILDING
     dir sw from rAquariumPark;
room "Burger Meister" tag rBurgerMeister
     style BUILDING
     style NAMECHANGE
     note "2061: Burgerworld"
     note "2071: Bar"
     dir ne from rAquariumPark;
room "Zoo" tag rZoo
     style PARK
     dir s from rZooEntrance;
link rZoo to rSkycarLot_AquariumPark;
room "Halley Park West" tag rHalleyParkWestW
     style PARK
     style NAMECHANGE
     note "2071: NO ACCESS"
     dir se from rZoo
     exit s;
link rZoo to rHalleyParkWestW
     dir s;
room "Halley Park West" tag rHalleyParkWestE
     style PARK
     style SUBWAY
     style NAMECHANGE
     note "2071: NO ACCESS"
     dir s from rSkycarLot_AquariumPark
     exit se;
link rHalleyParkWestE to rHalleyParkWestW style BIGROOM;
room "Halley Park East" tag rHalleyParkEast
     style PARK
     style NAMECHANGE
     note "2071: NO ACCESS"
     dir w w from rParkEntrance
     exit sw s;
link rHalleyParkEast to rHalleyParkWestE;
link rHalleyParkEast to rAquariumW;
join rHalleyParkWestE to rHalleyPark
     go se;
join rHalleyParkEast to rHalleyPark
     go sw;
join rHalleyParkEast to rHuangHall
     go s;
room "Train Station" tag rTrainStation
     style BUILDING
     style NAMECHANGE
     dir se from rBodanskiSquare
     exit sw
     note "2051: Church Lobby";
join rTrainStation to rMidlandRiver
     go sw;

room "Railroad Museum" tag rRailroadMuseum
     style BUILDING
     style NAMECHANGE
     note "2061: NO ACCESS"
     dir s from rMuseumEntrance;
room "Riverside Park" tag rRiversidePark
     style PARK
     style NAMECHANGE
     note "2071: NO ACCESS"
     dir e e from rMuseumEntrance;
link rRailroadMuseum to rRiversidePark
     dir e ne;
room "Simon's" tag rSimons
     style BUILDING
     dir ne from rBodanskiSquare;
room "Pickford Theatre" tag rPickfordTheatre
     style BUILDING
     dir e from rAquariumRiver;
room "Colonial Hotel" tag rColonialHotel
     style BUILDING
     dir se from rAirportwayRiver;
room "Skycar Lot" tag rSkycarLot_SymphonyEntrance
     style BUILDING
     dir sw from rSymphonyEntrance;
link rColonialHotel to rSkycarLot_SymphonyEntrance;
room "Cinema" tag rCinema
     style BUILDING
     dir nw from rMuseumEntrance;
room "Skycar Lot" tag rSkycarLot_MuseumEntrance
     style BUILDING
     dir n from rMuseumEntrance;
room "Symphony Hall" tag rSymphonyHall
     style BUILDING
     style NAMECHANGE
     note "2071: NO ACCESS"
     dir s from rSymphonyEntrance;
link rSymphonyHall to rSkycarLot_SymphonyEntrance;
link rSymphonyHall to rSkycarLot_MuseumEntrance;
link rCinema to rSkycarLot_SymphonyEntrance;
link rCinema to rSkycarLot_MuseumEntrance;
link rRiversidePark to rSkycarLot_MuseumEntrance
     dir nw w;
link rRiversidePark to rSymphonyHall
     dir n nw;
room "Terminal" tag rTerminal
     style BUILDING
     style SUBWAY
     dir n from rAirportEntrance;
room "Base Gate" tag rBaseGate
     style BUILDING
     dir n nw from rSymphonyEntrance;
room "Wells Theatre" tag rWellsTheatre
     style BUILDING
     dir sw from rAirportwayRiver;
link rWellsTheatre to rAquariumRiver;
room "Rockvil High" tag rRockvilHighW
     style BUILDING
     style NAMECHANGE
     note "2061: The Vincent School"
     dir w from rAirportwayRiver;
room "Rockvil High" tag rRockvilHighE
     style BUILDING
     style NAMECHANGE
     dir se from rRiverKennedy;
link rRockvilHighW to rRockvilHighE style BIGROOM;
room "Athletic Field" tag rAthleticFieldE
     style BUILDING
     dir sw from rRiverKennedy;
room "Athletic Field" tag rAthleticFieldW
     style BUILDING
     dir se from rRiverPark;
link rAthleticFieldW to rAthleticFieldE style BIGROOM;
room "Stadium Lot C" tag rStadiumLotC
     style BUILDING
     dir sw from rWaterTower;
room "Rockvil Stadium" tag rRockvilStadium
     style BUILDING
     style SUBWAY
     dir sw from rStadiumLotC;
room "Stadium Lot A" tag rStadiumLotA
     style BUILDING
     dir s from rRockvilStadium;
link rStadiumLotA to rZooEntrance;
room "Stadium Lot B" tag rStadiumLotB
     style BUILDING
     dir w s w from rRiverPark;
link rStadiumLotB to rRockvilStadium;
room "Rockvil Reformatory" tag rRockvilReformatory
     style BUILDING
     dir n from rWaterTower;

room "[Halley & University]" style JOIN
     dir s from rHalleyParkWestW nolink;
room "[Halley & Park]" style JOIN
     dir se from rHalleyParkWestE nolink;
room "[Huang Hall]" style JOIN
     dir s from rHalleyParkEast nolink;
room "[Centre & Kennedy]" style JOIN
     dir s from rParkEntrance nolink;
room "[Centre & Kennedy]" style JOIN
     dir sw from rBodanskiSquare nolink;
room "[Midland & River]" style JOIN
     dir s from rBodanskiSquare nolink;

########################################
map "Rockvil Central";

room "Elm & Park" tag rElmPark
     style ROAD
     exit w;
room "Elm & Kennedy" tag rElmKennedy
     style ROAD
     dir e e e from rElmPark;
room "Elm & River" tag rElmRiver
     style ROAD
     style SUBWAY
     dir e e e from rElmKennedy;
room "Main & Kennedy" tag rMainKennedy
     style ROAD
     dir n n n from rElmKennedy;
room "Rockvil Center" tag rRockvilCenter
     style ROAD
     dir w w w from rMainKennedy;
room "Main & River" tag rMainRiver
     style ROAD
     dir e e e from rMainKennedy
     exit e;
room "Centre & Kennedy" tag rCentreKennedy
     style ROAD
     dir ne ne ne from rRockvilCenter
     exit n ne;
room "Southway & Kennedy" tag rSouthwayKennedy
     style ROAD
     dir s s s from rElmKennedy;
room "Halley & Park" tag rHalleyPark
     style ROAD
     exit w nw ne
     dir n n n from rRockvilCenter;
room "Southway & Park" tag rSouthwayPark
     style ROAD
     dir s s s from rElmPark;
room "Midland & River" tag rMidlandRiver
     style ROAD
     dir n n n from rMainRiver
     exit n e ne;
room "Southway & River" tag rSouthwayRiver
     style ROAD
     dir s s s from rElmRiver;
room "Bend" tag rBend
     style ROAD
     exit se
     dir s s from rSouthwayRiver;

link rCentreKennedy to rMainKennedy;
link rRockvilCenter to rElmPark;
link rSouthwayRiver to rSouthwayKennedy;
link rSouthwayKennedy to rSouthwayPark;
link rElmRiver to rMainRiver;



room "Kennedy Park" tag rKennedyParkSE
     style PARK
     style NAMECHANGE
     dir nw from rElmKennedy
     note "2061: Construction Site"
     note "2071: NO ACCESS";
room "Kennedy Park" tag rKennedyParkSW
     style PARK
     style NAMECHANGE
     dir ne from rElmPark
     note "2061: Construction Site"
     note "2071: NO ACCESS";
room "Kennedy Park" tag rKennedyParkNE
     style PARK
     style NAMECHANGE
     dir sw from rMainKennedy
     note "2061: Construction Site"
     note "2071: NO ACCESS";
link rKennedyParkSW to rKennedyParkSE style BIGROOM;
link rKennedyParkNE to rKennedyParkSE style BIGROOM;

room "Dunbars" tag rDunbars
     style BUILDING
     style NAMECHANGE
     note "2071: NO ACCESS"
     dir se from rRockvilCenter;
room "Police Station" tag rPoliceStation
     style BUILDING
     dir sw from rElmPark;
room "Courthouse" tag rCourthouse
     style BUILDING
     dir nw from rElmPark;
room "Post Office" tag rPostOffice
     style BUILDING
     dir se from rElmPark;
room "Hospital" tag rHospital
     style BUILDING
     dir sw from rElmKennedy;
room "Stock Exchange" tag rStockExchangeW
     style BUILDING
     dir ne from rElmKennedy;
room "Rockvil Mall" tag rRockvilMallW
     style BUILDING
