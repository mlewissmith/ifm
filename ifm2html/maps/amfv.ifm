# http://www.eristic.net/games/infocom/amfv.html
# http://infocom.byethost3.com/games/infocom/index.html

room_width = 0.85;
room_height = 0.85;
room_text_fontsize = 16;
item_text_fontsize = 12;

title "A Mind Forever Voyaging";

style ROAD;
room_colour = "light gray";
endstyle ROAD;

style BUILDING;
room_colour = "beige";
#room_colour = "light blue";
endstyle BUILDING;

style PARK;
room_colour = "light green";
endstyle PARK;

style SUBWAY;
room_border_colour = "SteelBlue";
room_shadow_colour = "SteelBlue";
endstyle SUBWAY;

style BIGROOM;
#link_dashed = true;
#link_colour = "beige";
link_line_width = 12;
endstyle BIGROOM;

style NAMECHANGE;
room_text_colour = "DarkRed";
endstyle;

style JOIN;
room_colour = "white";
room_shadow_xoff = 0;
room_shadow_yoff = 0;
room_border_dashed = true;
room_text_font = "Times";
endstyle;

style MODE;
room_colour = "black";
room_text_colour = "GreenYellow";
item_text_colour = "GreenYellow";
endstyle;



################################################################################
# The Real World (2031)
map "PRISM";
room "Communications Mode" tag rCommunicationsMode
     style MODE
     note "\"You have a number of visual/audio units
set up at various points around the complex. When you enter Communications Mode,
you will be told where these units are, and how to activate them. When you have
activated a unit in a particular location, you are effectively 'in that
location.' You'll be able to see and hear what's going on, and talk to anyone
there. You won't be able to pick up things in those locations, of course.\""
     note "To move between modes, ENTER or GO TO <mode>."
     start;
room "Library Mode" tag rLibraryMode
     style MODE
     dir e 1 from rCommunicationsMode
     note "\"This is a storehouse of information, arranged in
directories which each contain a number of data files. When you enter Library
Mode, the usual style of typing an input and pressing the RETURN (or ENTER) key
is suspended. Follow the instructions that appear on your screen to access the
information in the files.\""
     score 5
     nolink;
room "Interface Mode" tag rInterfaceMode
     style MODE
     dir e 2 from rCommunicationsMode
     note "\"There are several subsidiary computers and complex
system controllers connected to you. More may be added over the course of the
story. By entering Interface Mode, you will be able to 'speak' to these other
devices, get information from them, possibly give them orders. You interface
with a device the same way that you would speak to a character in the story. For
example: TRAFFIC COMPUTER, SET EVENING RUSH HOUR END TO 5:00 or HVAC COMPUTER,
TURN ON VENTILATION IN GAMMA SECTOR. Data about these interfaceable devices can
be found in Library Mode.\""
     nolink;
room "Sleep Mode" tag rSleepMode
     style MODE
     dir e 3 from rCommunicationsMode
     note "\"Because sleep is a psychological as well as a physical
need, Sleep Mode has been provided to rest your conscious mind. Approximately
six hours will pass during an average sleep period.\""
     nolink;
room "Simulation Mode" tag rSimulationMode
     style MODE
     dir e 4 from rCommunicationsMode
     note "\"This is the process that was used to 'program' you
and develop you into a thinking, creative machine. Now, that same process,
programmed with the parameters of the Plan, will allow you to simulate the
future in amazing detail.  ABORT will get you out of Simulation Mode at any
time.  Because only you see what happens in Simulation Mode, you'll want to use
the RECORD feature to save what you see, so that others in the 'real world' can
view your experiences. RECORD or RECORD ON will activate it, and RECORD OFF will
de-activate it. Be warned, however, that RECORD makes an enormous demand on your
core memory, and you will only be able to record a limited amount of
experiences. Everything you see, feel, and learn in Simulation Mode can be
recorded. You can also use the RECORD feature in Communications Mode if you
want.\""
     nolink;

link rCommunicationsMode to rSleepMode
     cmd to "ENTER SLEEP MODE"
     cmd from "ENTER COMMUNICATION MODE"
     hidden ;
link rCommunicationsMode to rLibraryMode
     cmd to "ENTER LIBRARY MODE"
     cmd from "(exit)"
     hidden;
link rCommunicationsMode to rInterfaceMode
     cmd to "ENTER INTERFACE MODE"
     cmd from "ENTER COMMUNICATION MODE"
     hidden;
link rCommunicationsMode to rSimulationMode
     cmd to "ENTER SIMULATION MODE"
     cmd from "ABORT"
     hidden;
link rSleepMode to rInterfaceMode
     cmd to "ENTER INTERFACE MODE"
     cmd from "ENTER SLEEP MODE"
     hidden;
link rInterfaceMode to rLibraryMode
     cmd to "ENTER LIBRARY MODE"
     hidden
     oneway;
link rInterfaceMode to rSimulationMode
     cmd to "ENTER SIMULATION MODE"
     hidden
     oneway;
link rSleepMode to rSimulationMode
     cmd to "ENTER SIMULATOIN MODE"
     hidden
     oneway;
link rSleepMode to rLibraryMode
     cmd to "ENTER LIBRARY MODE"
     hidden
     oneway;

room "PRISM Project Control Center [PPCC]" tag rPPCC
     dir nw from rCommunicationsMode
     cmd to "PPCC"
     cmd from "(You are already in Communications Mode)";
room "Research Center Rooftop [RCRO]" tag rRCRO
     dir n from rCommunicationsMode
     cmd to "RCRO"
     cmd from "(You are already in Communications Mode)";
room "Dr Perelman's Office [PEOF]" tag rPEOF
     dir ne from rCommunicationsMode
     cmd to "PEOF"
     cmd from "(You are already in Communications Mode)";
room "PRISM Facility Cafeteria [PCAF]" tag rPCAF
     dir sw from rCommunicationsMode
     cmd to "PCAF"
     cmd from "(You are already in Communications Mode)";
room "Maintenance Core [MACO]" tag rMACO
     dir s from rCommunicationsMode
     cmd to "MACO"
     cmd from "(You are already in Communications Mode)";
room "World News Network Feed [WNNF]" tag rWNNF
     dir se from rCommunicationsMode
     cmd to "WNNF"
     cmd from "(You are already in Communications Mode)";

room "[Kennedy Park]" tag r2041
     style JOIN
     dir n from rSimulationMode
     join rKennedyParkSE;
room "[Elm & University]" tag r2051
     style JOIN
     dir ne from rSimulationMode
     join rElmUniversityTubeStation;
room "[Southway & River]" tag r2061
     style JOIN
     dir e from rSimulationMode
     join rSouthwayRiver;
room "[Bodanski Square]" tag r2071
     style JOIN
     dir se from rSimulationMode
     join rBodanskiSquare;
room "[Main & Wicker]" tag r2081
     style JOIN
     dir s from rSimulationMode
     join rMainWicker;
room "[Solarium]" tag r2091
     style JOIN
     dir sw from rSimulationMode
     join rSolarium2091;

item "Decoder Wheel" tag iDecoderWheel
     in rSimulationMode
     keep
     note "AQUA:        11=66, 15=47, 16=48, 18=67, 22=96, 27=70, 28=13, 29=51, 33=43, 34=90, 37=55, 40=81, 46=17, 49=41, 50=78, 52=92, 53=23, 58=83, 60=19, 61=20, 64=73, 68=39, 77=31, 82=88, 85=62, 86=54, 89=57, 91=99, 93=84, 94=12, 95=25, 98=36"
     note "BLACK:       11=23, 15=19, 16=67, 18=83, 22=73, 27=12, 28=62, 29=47, 33=92, 34=57, 37=17, 40=90, 46=13, 49=20, 50=81, 52=88, 53=31, 58=41, 60=78, 61=25, 64=84, 68=66, 77=43, 82=54, 85=51, 86=48, 89=96, 91=39, 93=70, 94=55, 95=36, 98=99"
