     note "DARKGREY:    11=99, 15=62, 16=88, 18=54, 22=90, 27=73, 28=55, 29=13, 33=23, 34=78, 37=70, 40=19, 46=12, 49=67, 50=47, 52=31, 53=39, 58=48, 60=51, 61=83, 64=57, 68=36, 77=66, 82=43, 85=17, 86=92, 89=81, 91=25, 93=96, 94=84, 95=41, 98=20"
     note "LIGHTBLUE:   11=36, 15=13, 16=92, 18=88, 22=81, 27=96, 28=12, 29=17, 33=66, 34=19, 37=84, 40=47, 46=70, 49=48, 50=51, 52=23, 53=99, 58=54, 60=62, 61=67, 64=90, 68=25, 77=39, 82=31, 85=55, 86=43, 89=78, 91=20, 93=57, 94=73, 95=83, 98=41"
     note "LIGHTGREEN:  11=41, 15=12, 16=23, 18=31, 22=47, 27=81, 28=73, 29=70, 33=36, 34=62, 37=57, 40=13, 46=96, 49=92, 50=17, 52=99, 53=20, 58=43, 60=55, 61=88, 64=19, 68=83, 77=25, 82=39, 85=84, 86=66, 89=51, 91=67, 93=78, 94=90, 95=54, 98=48"
     note "LIGHTGREY:   11=48, 15=73, 16=99, 18=39, 22=13, 27=47, 28=90, 29=96, 33=41, 34=55, 37=78, 40=12, 46=81, 49=23, 50=70, 52=20, 53=67, 58=66, 60=84, 61=31, 64=62, 68=54, 77=83, 82=25, 85=57, 86=36, 89=17, 91=88, 93=51, 94=19, 95=43, 98=92"
     note "ORANGE:      11=83, 15=70, 16=66, 18=23, 22=51, 27=78, 28=96, 29=84, 33=25, 34=13, 37=90, 40=17, 46=57, 49=43, 50=55, 52=36, 53=41, 58=31, 60=12, 61=92, 64=47, 68=67, 77=20, 82=99, 85=73, 86=39, 89=62, 91=48, 93=19, 94=81, 95=88, 98=54"
