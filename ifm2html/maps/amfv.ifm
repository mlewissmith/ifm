################################################################################

map "Apartment, 2091";

room "Solarium" tag rSolarium2091;
room "Patio" tag rPatio2091
     dir s from rSolarium2091;
room "Living Room" tag rLivingRoom2091
     dir n from rSolarium2091;
room "Dining Room" tag rDiningRoom2091
     dir e from rLivingRoom2091;
room "Kitchen" tag rKitchen2091
     dir e from rDiningRoom2091;
room "Master Bedroom" tag rMasterBedroom2091
     dir ne from rLivingRoom2091
     go u;
room "Foyer" tag rFoyer2091
     dir n n from rLivingRoom2091;
room "Guest Room" tag rGuestRoom2091
     dir e from rFoyer2091;
room "Den" tag rDen2091
     dir w from rFoyer2091;
room "Bathroom" tag rBathroom2091
     dir sw from rFoyer2091;

room "Skycab" tag rSkycab2091
     dir n from rFoyer2091 oneway;

################################################################################
### TASKS

item "2041" tag i2041
     in r2041
     need iDecoderWheel;
item "2051" tag i2051
     in r2051
     after tDataDump2041
     need iDecoderWheel;
item "2061" tag i2061
     in r2061
     after tDataDump2051
     need iDecoderWheel;
item "2071" tag i2071
     in r2071
     after tDataDump2061
     need iDecoderWheel;
item "2081" tag i2081
     in r2081
     after tDataDump2071
     need iDecoderWheel;
# item "2091" tag i2091
#      in r2091
#      after tPartIII
#      need iDecoderWheel;

task "- Part I -" tag tPartI
     in any
     note "You \"hear\" a message coming in on the official message line: \"PRISM? Perelman here. The psych tests have all checked out at 100%, which means that you've recovered from the, ah, awakening without any trauma or other serious effects. We'll be ready to begin the simulation soon. By the way, your piece is in the current issue of Dakota Online.\""
     note "- Some useful commands: ABORT, BRIEF/SUPERBRIEF/VERBOSE, DIAGNOSE, RECORD ON/OFF, SCRIPT/UNSCRIPT"
     note "- Wait until Perelman gives you instructions...  Go to Library Mode and read some documentation.  Explore the communication outlets. Or have a sleep."
;

task "[2041 Tasks]" tag t2041
     need i2041
     in any
     note "- Eating a meal in a restaurant"
     note "- Talking to a government official"
     note "- Visiting a power-generating facility"
     note "- Reading a newspaper"
     note "- Riding some form of public transportation"
     note "- Attending a court in session"
     note "- Talking to a church official"
     note "- Going to a movie"
     note "- Visiting your own home or living quarters"
;

item "recording" tag iRecording2041a
     need i2041 in rSimons lost
     note "- Eating a meal in a restaurant.  $65";
item "recording" tag iRecording2041b
     need i2041 in rBurgerMeister lost
     note "- Eating a meal in a restaurant.  $20";
item "recording" tag iRecording2041c
     need i2041 in rTheCoachman lost
     note "- Eating a meal in a restaurant.  $65";
item "recording" tag iRecording2041d
     need i2041 in rRoysPagoda lost
     note "- Eating a meal in a restaurant.  $30";
item "recording" tag iRecording2041e
     need i2041 in rCityHall lost
     note "- Talking to a government official";
item "recording" tag iRecording2041f
     need i2041 in rPowerStation lost
     note "- Visiting a power-generating facility";
item "recording" tag iRecording2041g
     need i2041 in rBodanskiSquare lost
     note "- Reading a newspaper";
item "recording" tag iRecording2041h
     need i2041 in rBodanskiSquareTubeStation lost
     note "- Riding some form of public transportation";
item "recording" tag iRecording2041i
     need i2041 in rCourthouse lost
     note "- Attending a court in session";
item "recording" tag iRecording2041j
     need i2041 in rStMichaels lost
     note "- Talking to a church official";
item "recording" tag iRecording2041k
     need i2041 in rFirstMethodistChurch lost
     note "- Talking to a church official";
item "recording" tag iRecording2041l
     need i2041 in rCinema lost
     note "- Going to a movie";
item "recording" tag iRecording2041m
     need i2041 in rLivingRoom lost
     note "- Visiting your own home or living quarters";


task "SHOW RECORDINGS TO PERELMAN" tag tDataDump2041
     in rPEOF
     need i2041 drop it in r2041
     need iRecording2041a iRecording2041b iRecording2041c iRecording2041d iRecording2041e
          iRecording2041f iRecording2041g iRecording2041h iRecording2041i iRecording2041j
          iRecording2041k iRecording2041l iRecording2041m
;

task "- Part II -" tag tPartII
     in any
     after tDataDump2041
     note "Perelman walks into the office and spots the active light on your communication unit immediately. \"Hello, PRISM,\" he says, sitting down at his desk. \"It looks like you beat me here. Give me a moment, please.\" He begins quickly jotting a few notes onto a pad."
     note "Perelman looks up, smiling. \"An excellent job, PRISM. We just finished viewing your recordings, and the experts were quite pleased.\" He pauses, as though realizing something for the first time. \"In fact, I thought they looked pretty good myself. I suppose this means the Plan'll get adopted."
     note "\"What's next for you, I wonder? You're going to be a hero, you know. You'd probably get a call from the President congratulating you, except of course that he's against the Plan.\" Perelman notices a paper on his desk. \"Oh, apparently the Simulation Controller generated a lot of new data correlations while running your simulation. I'm not sure what the effect of that will be. Might make an even more accurate simulation possible.\""
;

task "[2051 Tasks]" tag t2051
     need i2051
     in r2051
     note "Record sights and events totaling (at least) 11 points from 2051."
     note "Spending over 300 minutes in 2051 will make a 2061 simulation possible."
;

item "recording" tag iRecording2051a
     need i2051 in rLivingRoom lost
     note "- The BSF raid, which happens within your first 20 turns in your apartment"
     score 3;
item "recording" tag iRecording2051b
     need i2051 in rBodanskiSquare lost
     note "- Reading the newspaper after getting a copy"
     score 3;
item "recording" tag iRecording2051c
     need i2051 in rLivingRoom lost
     note "- Looking through the window in your apartment"
     score 3;
item "recording" tag iRecording2051d
     need i2051 in rCityDump lost
     note "- LOOK when you're in the City Dump (also 2061 and 2071)"
     score 3;
item "recording" tag iRecording2051e
     need i2051 hidden in r2051 lost
     note "- The sirens announcing curfew, which you can hear from anywhere at 9 p.m. (also 2061 and 2071)"
     score 2;
item "recording" tag iRecording2051f
     need i2051 in rCityHall lost
     note "- Talking to the government official at City Hall"
     score 2;
item "recording" tag iRecording2051g
     need i2051 in rClosedFactory lost
     note "- LOOK when you're in the Soup Kitchen, or just outside it"
     score 2;
item "recording" tag iRecording2051h
     need i2051 in rCourthouse lost
     note "- LOOK when you're in the Courthouse"
     score 2;
item "recording" tag iRecording2051i
     need i2051 in rTrainStation lost
     note "- LOOK when you're in the Church of God's Word"
     score 2;
item "recording" tag iRecording2051j
     need i2051 in rBodanskiSquare lost
     note "- Examining the newspaper dispenser in Bodanski Square"
     score 2;
item "recording" tag iRecording2051k
     need i2051 in rDorm lost
     note "- The police raid on the Dorm, which happens within your first several turns there"
     score 2;
item "recording" tag iRecording2051l
     need i2051 in rHalleyUniversity lost
     note "- Skycopter at Halley & University announcing a prayer meeting which happens within your first several turns there"
     score 1;
item "recording" tag iRecording2051m
     need i2051 in rTrainStation lost
     note "- Reading the pamphlet from the Church of God's Word lobby"
     score 1;
item "recording" tag iRecording2051n
     need i2051 in rCinema lost
     note "- Reading the marquee at the Cinema, or watching a movie"
     score 1;
item "recording" tag iRecording2051o
     need i2051 in rMainWicker lost
     note "- Reading the bordello flyer from the man at Main & Wicker"
     score 1;
item "recording" tag iRecording2051p
     need i2051 in rAquariumW lost
     note "- Looking in the tank at the Aquarium (also 2061 and 2071)"
     score 1;
item "recording" tag iRecording2051q
     need i2051 in rSkycarFactory lost
     note "- LOOK when you're in the Skycar Factory"
     score 1;
item "recording" tag iRecording2051r
     need i2051 in rRockvilReformatory lost
     note "- LOOK when you're in the Rockvil Reformatory"
     score 1;
item "recording" tag iRecording2051s
     need i2051 in rPowerStation lost
     note "- LOOK when you're in the Power Station"
     score 1;
item "recording" tag iRecording2051t
     need i2051 in rHealthCenter lost
     note "- LOOK when you're in the Health Center"
     score 1;
item "recording" tag iRecording2051u
     need i2051 in rBodanskiSquareTubeStation lost
     note "- LOOK when you're in any tubecar"
     score 1;
item "recording" tag iRecording2051v
     need i2051 in rHuangHall lost
     note "- LOOK when you're in Huang Hall"
     score 1;
item "recording" tag iRecording2051w
     need i2051 in rHalleyMuseum lost
     note "- LOOK when you're in Halley Museum"
     score 1;
item "recording" tag iRecording2051x
     need i2051 in rPier lost
