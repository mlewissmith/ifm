     note "BROWN:       11=20, 15=55, 16=31, 18=43, 22=19, 27=90, 28=84, 29=12, 33=99, 34=51, 37=96, 40=62, 46=73, 49=88, 50=13, 52=39, 53=25, 58=92, 60=17, 61=54, 64=78, 68=41, 77=36, 82=66, 85=70, 86=23, 89=47, 91=83, 93=81, 94=57, 95=48, 98=67"
